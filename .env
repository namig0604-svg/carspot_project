# Database
DATABASE_URL=postgresql://carspot_user:carspot_password@localhost:5432/carspot_db

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
APP_NAME=CarSpot API
APP_VERSION=0.1.0
DEBUG=True

# CORS
ALLOWED_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8080", "http://localhost:8100"]

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads
