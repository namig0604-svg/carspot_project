# Скопируйте в .env для локальной разработки

# База данных. Локально можно оставить SQLite:
DATABASE_URL=sqlite:///./carspot.db
# Для локального Postgres в Docker:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carspot_db

# Секрет для подписи JWT. На проде обязательно поменяйте!
SECRET_KEY=change-me-to-a-long-random-string

# Время жизни токена в минутах (по умолчанию 7 дней)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Папка для загруженных фото
UPLOAD_DIR=uploads

# Максимальный размер файла в байтах (10 МБ)
MAX_UPLOAD_SIZE=10485760

# CORS: список доменов через запятую или * для всех
ALLOWED_ORIGINS=*

# Подробные SQL-логи
DEBUG=false
